      <RevitAddinsFolder>$(AppData)\Autodesk\Revit\Addins\2026</RevitAddinsFolder>
    </PropertyGroup>
    <ItemGroup>
      <FilesToCopy Include="$(OutputPath)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(RevitAddinsFolder)\Materialdex\%(RecursiveDir)" />
    <Copy SourceFiles="Materialdex.addin" DestinationFolder="$(RevitAddinsFolder)" />
  </Target> -->

</Project>

